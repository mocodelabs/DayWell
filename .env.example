# DayWell configuration. Copy to backend/.env (development) or .env.prod (docker-compose.prod.yml).
# Never commit real values. Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(50))"

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_ALLOWED_HOSTS=daywell.example.com
CSRF_TRUSTED_ORIGINS=https://daywell.example.com
FRONTEND_URL=https://daywell.example.com
# Number of trusted reverse proxies in front of Django (nginx in docker-compose.prod.yml = 1, plus your TLS proxy).
NUM_PROXIES=2
LOG_LEVEL=INFO

# --- Database & cache ---
POSTGRES_DB=daywell
POSTGRES_USER=daywell
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://daywell:change-me@db:5432/daywell
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# --- Encryption of push subscription keys at rest (comma-separated Fernet keys, newest first) ---
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# --- Web Push (VAPID). Leave empty to disable push; in-app alarms still work. See docs/DEPLOYMENT.md. ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@daywell.example.com
WEB_PUSH_TTL=900

# --- Email (password reset, verification) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=DayWell <no-reply@daywell.example.com>
REQUIRE_EMAIL_VERIFICATION=false

# --- Reminder engine tuning ---
REMINDER_HORIZON_DAYS=14
REMINDER_STALE_AFTER_MINUTES=15
REMINDER_MAX_ATTEMPTS=4
TASK_SERIES_HORIZON_DAYS=21

# --- Rate limits ---
THROTTLE_AUTH=10/minute
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_USER=1200/hour

# --- Ports ---
HTTP_PORT=8080

# --- Web server concurrency (gunicorn gthread) ---
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
